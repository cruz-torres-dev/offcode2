# Copy to .env, never commit the completed file.
PORT=8000
PUBLIC_ORIGIN=http://localhost:8000
# false: order requests are rejected by the server, even if the private panel
# saved "enabled: true". The panel cannot override this switch. VIP has its own.
ORDERS_ENABLED=false
# Independent of sales. Requires ADMIN_PASSWORD and the real PRIVACY_URL.
WAITLIST_ENABLED=false
# Use at least 16 characters. No default password is provided.
ADMIN_PASSWORD=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 64 hex characters, private. Keep its backup outside Git; never replace after saving settings.
SETTINGS_ENCRYPTION_KEY=
# SQLite privado. Local: esta ruta; Render: /var/data/offcode.sqlite en disco /var/data.
# No cambies una ruta existente sin respaldar y comprobar sus datos.
DATABASE_PATH=./data/offcode.sqlite
# Por defecto el journal de correo vive en <DATABASE_PATH>.email-outbox/.
# Si ya usabas EMAIL_OUTBOX_DIR, conserva su ubicación y copia el journal con la base.
NODE_ENV=development
# Digits only, country code included, e.g. a real Mexico sales number (52...).
SALES_WHATSAPP=
BANK_NAME=
BANK_BENEFICIARY=
BANK_CLABE=
# Optional HTTPS links, displayed when supplied; not required to enable orders/shipping.
PRIVACY_URL=
TERMS_URL=
# The normal store is always the home page. Kept for older hosting settings.
HOME_PAGE=store
# Trust Render's sanitized client-IP header ONLY on a Render web service.
# Leave false for direct local access. Never enable on an untrusted/public proxy.
TRUST_RENDER_PROXY=false
# Envia remains disabled until the owner supplies and validates the real data.
# FedEx is the only carrier used: any other carrier returned by Envia is discarded.
# Keep the token private, outside dist/ and Git. Separate sandbox/production tokens.
ENVIA_ENABLED=false
ENVIA_ENVIRONMENT=sandbox
ENVIA_TOKEN=
# One-line JSON: name,phone,email,street,number,district,city,state,country,postalCode.
# country must be MX; state must be Envia's two-character code (not ISO guesses).
ENVIA_ORIGIN_JSON={}
# One measured parcel profile per TOTAL garment quantity. Weight KG, dimensions CM.
# Shape only: {"1":{"weight":REAL_KG,"dimensions":{"length":REAL_CM,"width":REAL_CM,"height":REAL_CM}}}
# No invented dimensions or multiplied unit weights are used for larger orders.
ENVIA_PACKAGES_JSON={}
ENVIA_PRINT_SIZE=PAPER_4X6
# Optional transactional email. Explicit opt-in, independently of ORDERS_ENABLED.
# Server-only secrets; EMAIL_FROM must be one plain address in a verified domain.
# Verify a SUBDOMAIN in Resend: offcode.mx already has mailboxes in Solucionix and
# its MX/SPF/DKIM records must not be replaced. See OPERACION.md.
# Adding the key does NOT enable sending: only EMAIL_ENABLED=true does.
# Never paste real values into this example or public frontend files.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=
